# Ollama Configuration for Windows
# The command to start Ollama on Windows
# Make sure Ollama is installed from https://ollama.com/download
OLLAMA_START_CMD=ollama serve

# Ollama server host
OLLAMA_HOST=127.0.0.1

# Ollama server port
OLLAMA_PORT=11434

# Time to wait for Ollama to start (seconds)
OLLAMA_START_TIMEOUT=30

# Interval to check if Ollama is ready (seconds)
OLLAMA_CHECK_INTERVAL=0.5
