# ============================================
# Backend Environment Configuration
# ============================================
# NEVER commit this file to version control

# ============================================
# Model Configuration (REQUIRED - Keep Secret)
# ============================================
# Ollama model name - MUST be set, no default for security
OLLAMA_MODEL=qwen2.5:7b-instruct

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# API Configuration
# ============================================
API_BASE_URL=http://localhost:8000
API_VERSION=v1
API_PREFIX=/api

# ============================================
# Application Metadata
# ============================================
APP_TITLE=Hybrid Chat API
APP_VERSION=1.0.0
APP_DESCRIPTION=Hybrid chat system using RAG and LLM

# ============================================
# CORS Configuration
# ============================================
# Frontend URL (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins (comma-separated)
# If not set, uses FRONTEND_URL
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS origin regex pattern for dynamic subdomains (e.g., localtunnel)
CORS_ORIGIN_REGEX=https?://.*\.loca\.lt

# ============================================
# Project Paths Configuration
# ============================================
# Project root directory (if empty, calculated from backend location)
# Example: /path/to/Supportron or C:\Projects\Supportron\Supportron
PROJECT_ROOT=C:\Projects\Supportron

# Data processing directory (if empty, calculated as PROJECT_ROOT/data-processing)
# Example: /path/to/Supportron/data-processing
DATA_PROCESSING_PATH=C:\Projects\Supportron\data-processing

# Logs directory (default: logs, relative to project root)
# Example: logs or /var/log/supportron
LOGS_DIRECTORY=logs

# ============================================
# Vector Database Configuration
# ============================================
# Vector database path (if empty, calculated as DATA_PROCESSING_PATH/vector_db)
# Example: data-processing/vector_db or /path/to/vector_db
VECTOR_DB_PATH=C:\Projects\Supportron\data-processing\vector_db

# Log file path (if empty, calculated as LOGS_DIRECTORY/api.log)
# Example: logs/api.log or /var/log/supportron/api.log
LOG_FILE=C:\Projects\Supportron\backend\logs\api.log

# ============================================
# RAG Configuration
# ============================================
RAG_MAX_DISTANCE=0.8
RAG_TOP_DOCS=3
RAG_CONTEXT_LENGTH=400
RAG_PREVIEW_LENGTH=200

# ============================================
# Ollama Generation Options
# ============================================
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40

# ============================================
# Ollama Service Configuration
# ============================================
# The command to start Ollama on Windows
# Make sure Ollama is installed from https://ollama.com/download
OLLAMA_START_CMD=ollama serve

# Ollama server host
OLLAMA_HOST=127.0.0.1

# Ollama server port
OLLAMA_PORT=11434

# Time to wait for Ollama to start (seconds)
OLLAMA_START_TIMEOUT=30

# Interval to check if Ollama is ready (seconds)
OLLAMA_CHECK_INTERVAL=0.5

# ============================================
# Code Detection Thresholds
# ============================================
MIN_TEXT_LENGTH_FOR_EXTRACTION=10
MIN_CODE_LENGTH=5
MAX_WORDS_FOR_CODE=8
MAX_WORDS_FOR_SENTENCE=6

# ============================================
# Database Configuration
# ============================================
DB_DIRECTORY=databases

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO

# ============================================
# Security Configuration
# ============================================
# Hide model information in API responses (default: true)
HIDE_MODEL_INFO=true
