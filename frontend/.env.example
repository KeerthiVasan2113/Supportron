# ============================================
# Frontend Environment Configuration
# ============================================
# Copy this file to .env.local and update with your values
# NEVER commit .env.local file to version control

# ============================================
# API Configuration (REQUIRED)
# ============================================
# Backend API base URL
# Examples:
#   Development: http://localhost:8000
#   Production: https://api.yourdomain.com
#   Tunnel: https://your-tunnel.loca.lt
NEXT_PUBLIC_API_URL=http://localhost:8000

# API version (default: v1)
NEXT_PUBLIC_API_VERSION=v1

# ============================================
# Application Configuration
# ============================================
# Application title
NEXT_PUBLIC_APP_TITLE=Supportron

# Application description
NEXT_PUBLIC_APP_DESCRIPTION=AI-Powered Technical Support Assistant

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_SOURCES=true
NEXT_PUBLIC_ENABLE_CHAT_HISTORY=true

